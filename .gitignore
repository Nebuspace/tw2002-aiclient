*.pyc
.pytest_cache/

# Real host/port + any other local secrets-adjacent env overrides — see
# twclient/env.py's resolution order. Never tracked.
.env

# Internal orchestration/agent-memory -- not part of the shippable
# client (hub ruling, 2026-07-19).
.samantha/
.claude/
CLAUDE.local.md

# B2 secure credential store — profiles.toml is non-secret shape (host/
# port/game-letter/handle) but still local-only; secrets.json holds
# passwords and must NEVER be tracked. profiles.toml.example is the only
# tracked file in config/.
config/profiles.toml
config/secrets.json
config/*.local.*

# OS cruft + stray logs outside the tracked logs/ dir (Cipher's
# forward-looking gap, 2026-07-19).
.DS_Store
*.log

# Live orchestration/planning journals -- never public; the curated
# public canon is knowledge/ (hub ruling, 2026-07-19).
DESIGN-v2.md
QUEUE.md
TUI-POLISH-PLAN.md

# Local-only / reference trees — never scoop into a public commit
# (hub ruling WO-P3-HYGIENE-GITIGNORE, 2026-07-24). archive/ holds the
# pre-rebirth product (secrets-adjacent); do not track or broad-add it.
archive/
workorders/drafts/
.samantha-coord
.samantha-identity
*.code-workspace
.cursor/rules/
.cursor/sandbox.json

# Research corpora (ClassicTW helpers, TWGS Windows binaries) — never commit
research/raw/

# Accidental root drops of TWGS Windows packages (move to research/raw/twgs/)
/TWGS*.EXE
/TWGS*.exe
/TOOLS100.zip

# Editable-install build artifact. `CLAUDE.md` tells every operator to run
# `pip install -e .`, so this appears in every clone and was permanent
# untracked noise until it was ignored.
*.egg-info/
