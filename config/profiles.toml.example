# profiles.toml.example — SHAPE TEMPLATE ONLY, tracked in git.
#
# This file documents the shape of a profile entry. It is NOT read by the
# client at runtime. Your real, local profile table lives at
# `config/profiles.toml` (gitignored — see .gitignore's B2 block) — copy
# this file there and fill in your own values.
#
# NO PASSWORD FIELD EXISTS HERE OR IN THE REAL profiles.toml. Per
# canon/doctrine/secrets-and-credentials.md, a password's only on-disk
# home is the separate, gitignored, chmod-600 `config/secrets.json` —
# resolved at use-time by twclient/credentials.py's get_password(), never
# read out of this table.
#
# Fields:
#   server            - preferred: catalog key from config/servers.toml
#                        (host/port resolve at load time from the catalog).
#   host              - optional override hostname if not using `server`.
#   port              - optional override port (int) if not using `server`.
#   game_letter       - the single-letter game selection at the TWGS menu.
#   handle            - your character's login handle.
#   ship_name         - optional; ship name override.
#   planet_name       - optional; planet name override.
#   allow_register    - opt-in gate for automated NEW-character
#                        registration. Default false; leave false unless
#                        you understand what it enables.
#   crawl_sacrificial - opt-in gate marking this profile as a disposable,
#                        zero-asset character safe for automated crawling.
#                        Default false.
#   autopilot         - opt-in gate for the Autopilot driver taking
#                        autonomous actions on this profile. Default false.

[example]
server = "example_one"
# host = "example.host"   # only if not using a catalog `server` key
# port = 2002
game_letter = "A"
handle = "character-one"
# ship_name = "MyShip"
# planet_name = "MyWorld"
allow_register = false
crawl_sacrificial = false
autopilot = false
