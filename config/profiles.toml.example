# Copy this file to profiles.toml (gitignored) and fill in real values.
# profiles.toml holds NON-SECRET shape only — host/port/game-letter/handle.
# Passwords NEVER go here; they live out-of-band in config/secrets.json
# (auto-created, chmod 600) or an env var TW2002_PASSWORD_<PROFILE> —
# see twclient/credentials.py.
#
# host/port here are a fallback only: TW2002_HOST/TW2002_PORT (process
# env or the gitignored repo-root .env) resolve first — see
# twclient/env.py's resolution order.
#
# WO-MS-1: optional `server = "<catalog-key>"` resolves hostname/port from
# config/servers.toml when host/port are omitted (`tw servers list` shows
# keys). Existing host/port fields still work unchanged (backcompat).
#
# ship_name / planet_name are optional; default to "<handle>Ship" /
# "<handle>World" if omitted.
#
# WO-MS-4: `allow_register = true` opts a profile IN to automated
# NEW-character registration -- default false/omitted means login.py
# refuses to register (registration_not_permitted) rather than silently
# creating a character. Only an allow_register profile may also omit
# `handle` entirely: twclient/name_bank.py then draws a fresh
# handle/ship_name/planet_name per registration attempt instead of
# pinning one (see register_with_name_bank()). Any of those three fields
# you DO set explicitly always wins over the bank draw.
#
# Autopilot (Trainer): `autopilot = true` opts the profile into the
# trainer tick loop at session start (legacy synonym: `autonomous = true`).
# The tw2002-aiclient play screen can flip this live and write it back here.
#
# Daemon socket (product client): default is shared `run/` under the project
# root. For an isolated test seat (e.g. live `run/rogue/`), set env
# `TW_RUN_DIR=run/rogue` (or an absolute path) before launching
# `./tw2002-aiclient` / `tw aiclient`.
#
# Retired seats (lockout / discarded hosts): set `retired = true` so the
# product launcher lists them after active profiles, greys them, and skips
# select. Do NOT delete the section — world-models and secrets stay put.
# Create-new still only offers catalog servers.

[default]
host = "your-twgs-host.example"
port = 23
game_letter = "F"
handle = "YourHandle"
# ship_name = "MyShip"
# planet_name = "MyWorld"
# allow_register = true
# autopilot = false
# retired = false

# Example catalog-backed profile (host/port filled from servers.toml):
# [catalog_demo]
# server = "geekm0nkey_com"
# game_letter = "F"
# handle = "Demo"
# autopilot = true

# Example retired seat (still on disk; launcher greys + skips):
# [old_seat]
# server = "some_catalog_key"
# game_letter = "A"
# handle = "OldHandle"
# retired = true
